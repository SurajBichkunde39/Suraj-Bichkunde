---
import type { CollectionEntry } from 'astro:content';

interface Props {
	article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<article class="card">
	<h3><a href={`${base}articles/${article.id}/`}>{article.data.title}</a></h3>
	<p class="meta">
		{article.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
	</p>
	{article.data.summary && <p>{article.data.summary}</p>}
	<p class="tags">
		{article.data.tags.map((tag) => (
			<a href={`${base}tags/${tag}/`}>#{tag}</a>
		))}
	</p>
</article>

<style>
	.card {
		border-bottom: 1px solid #ddd;
		padding: 1rem 0;
	}
	.card h3 {
		margin: 0 0 0.25rem;
	}
	.meta {
		color: #666;
		font-size: 0.9rem;
		margin: 0 0 0.5rem;
	}
	.tags {
		display: flex;
		gap: 0.75rem;
		font-size: 0.85rem;
	}
	.tags a {
		color: #666;
	}
</style>
