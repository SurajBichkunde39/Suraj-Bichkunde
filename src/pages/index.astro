---
import BaseLayout from '../layouts/BaseLayout.astro';

// Turns two dates into a string like "3 yrs 4 mos" (or just "8 mos" under
// a year). Pass `end: null` for a role that's still ongoing — it's
// measured against today at build time, so it stays accurate without
// ever needing a manual edit. Counts inclusively (both the start month
// and end month count as full months), matching how LinkedIn shows
// tenure - joining partway through a month still credits that month.
function formatDuration(start: Date, end: Date | null): string {
	const endDate = end ?? new Date();
	let months = (endDate.getFullYear() - start.getFullYear()) * 12 + (endDate.getMonth() - start.getMonth()) + 1;
	months = Math.max(months, 1);

	const years = Math.floor(months / 12);
	const remainingMonths = months % 12;

	const parts: string[] = [];
	if (years > 0) parts.push(`${years} yr${years > 1 ? 's' : ''}`);
	if (remainingMonths > 0 || years === 0) parts.push(`${remainingMonths} mo${remainingMonths !== 1 ? 's' : ''}`);
	return parts.join(' ');
}
